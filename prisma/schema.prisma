generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Ioc {
  id         Int       @id @default(autoincrement())
  value      String
  normalized String    @unique
  type       String
  note       String?
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?
  tags       IocTag[]
}

model Tag {
  id   Int      @id @default(autoincrement())
  name String   @unique
  iocs IocTag[]
}

model IocTag {
  iocId Int
  tagId Int
  ioc   Ioc @relation(fields: [iocId], references: [id], onDelete: Cascade)
  tag   Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([iocId, tagId])
}
