generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Ioc {
  id         Int      @id @default(autoincrement())
  value      String   // original value as submitted
  normalized String   @unique // canonical form for dedup
  type       String   // ipv4 | domain | url | md5 | sha1 | sha256
  note       String?
  createdAt  DateTime @default(now())
  tags       IocTag[]
}

model Tag {
  id   Int      @id @default(autoincrement())
  name String   @unique
  iocs IocTag[]
}

model IocTag {
  iocId Int
  tagId Int
  ioc   Ioc @relation(fields: [iocId], references: [id], onDelete: Cascade)
  tag   Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([iocId, tagId])
}
